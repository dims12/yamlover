# Copy to ~/.config/yamlover-demo.env. Referenced by the user systemd unit
# (EnvironmentFile=%h/.config/yamlover-demo.env). Lives outside the deploy dir so a code
# redeploy (rsync --delete) never overwrites it.
#
# NOTE: systemd EnvironmentFile does NOT strip trailing `#` comments — an inline comment
# becomes part of the value. So every comment here is on its own line, never after a value.

# --- core ---
DEMO_DRIVER=docker
DEMO_BASE_URL=https://yamlover.inthemoon.net
HOST=127.0.0.1
PORT=8080

# --- lifecycle / limits ---
TTL_DAYS=3
MAX_DEMOS=50
# optional: also reclaim demos idle this long
# IDLE_HOURS=12

# --- persistence (kept under the deploy dir; rsync excludes .data/) ---
DB_PATH=/home/dims/Design/www/yamlover-demo/.data/demos.db

# --- docker driver (image published on Docker Hub by CI) ---
DEMO_IMAGE=dimskraft/yamlover-demo:latest
# set to 0 to skip the startup `docker pull` (e.g. a locally-built tag)
# DEMO_IMAGE_PULL=0
DOCKER_MEMORY=512m
DOCKER_CPUS=1

# --- the always-on read-only docs instance (served at /docs) ---
# set to 0 to turn it off entirely
DOCS_ENABLED=1
DOCS_IMAGE=dimskraft/yamlover-docs:latest
# how often (ms) to re-pull the docs image and recreate the container if the tag moved;
# this is what makes a docs edit go live without a redeploy. Default: same as the reaper.
# DOCS_REFRESH_MS=1800000
# DOCS_BASE_PATH=/docs

# --- the always-on read-only examples instance (served at /examples) ---
# Twin of /docs: published examples/, not a visitor demo. EXAMPLES_DIR is the process-driver
# content for writable demos; these SITE_* knobs are the public showcase.
# set to 0 to turn it off entirely
EXAMPLES_SITE_ENABLED=1
EXAMPLES_SITE_IMAGE=dimskraft/yamlover-examples:latest
# EXAMPLES_SITE_REFRESH_MS=1800000
# EXAMPLES_SITE_BASE_PATH=/examples

# --- email ---
# RESEND_API_KEY is NOT set here — it comes from /etc/resend.env via the unit's second
# EnvironmentFile (root-owned, group-readable by dims). EMAIL_FROM's domain must be
# verified in Resend (resend.com/domains: SPF/DKIM). Until then either point EMAIL_FROM at
# onboarding@resend.dev (delivers only to your own Resend account address) or set
# EMAIL_PROVIDER=console to log links to `journalctl --user -u yamlover-demo`.
EMAIL_PROVIDER=resend
EMAIL_FROM=yamlover demo <noreply@yamlover.inthemoon.net>
# EMAIL_PROVIDER=console

# --- abuse limits ---
# per-IP registration token bucket
REGISTER_PER_HOUR=3
# global cap on NEW demos per rolling 24h (bounds Resend sends + spawned instances)
REGISTER_PER_DAY=200

# --- captcha (Cloudflare Turnstile) ---
# Both unset → captcha disabled (the form still works). Set both to enable. The secret can
# also live in a root-only EnvironmentFile like the Resend key.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET=0x4AAAAAAA...

# --- logging ---
# The process only writes to stdout; systemd journals it and the Ops Agent forwards it to
# Google Cloud Logging (deploy/ops-agent-config.yaml). Nothing here talks to Google.
# json (the default off a TTY) | text
LOG_FORMAT=json
# debug | info | notice | warning | error
LOG_LEVEL=info
# Which proxied exchanges are logged. Every SPA asset and every SSE poll comes through here,
# so `all` is a firehose and Cloud Logging bills by volume — `errors` keeps the 4xx/5xx that
# need tracing and leaves the traffic questions to GA4. errors | all | off
LOG_HTTP=errors
# Relay each yamlover instance's own output (indexing, errors) into the same stream, tagged
# with its demo hash. Set to 0 to log only the orchestrator.
LOG_INSTANCES=1

# --- analytics (Google Analytics 4) ---
# Unset → nothing is injected anywhere and no instance is given the variable, so a demo, the
# docs, the examples site and every self-hosted or `npx yamlover` tree stay free of any third-party script.
# The measurement id is public (it ships in the page); it is here, not in the repo, so the
# checked-in HTML has no tag in it and a fork does not report to this property.
# Demos report as /demo/<id> with no sub-path and no document title — the hash is the
# instance's only credential, and below the mount point the URL is the visitor's own data.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
