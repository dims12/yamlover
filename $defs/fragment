# $defs/fragment — a user-marked REGION inside a document (the locate/highlight data only; no
# color). Stored under the host node's `.yo: fragments:` mapping (the legacy `yo:` spelling is
# read forever), keyed by a slug. `type` selects the locator: a text quote {type:text, exact,
# prefix, suffix}, an image / pdf / djvu rect {type:rect|pdf|djvu, x,y,w,h (pdf/djvu add page)},
# or a map box {type:map, n,s,e,w (geographic edges)}. Image-like fragments also carry an
# `image` — a PNG crop of the region (a sidecar blob, referenced by a `*` pointer). A fragment
# is tagged by MEMBERSHIP BOOKMARKS (`&…:-` own-line, docs/annotations/applications).
# Attach with the tag  !!<*::yamlover/$defs/fragment>.
type: object
format: x-yamlover-fragment
members:
  type:
    type: string
    description: The locator kind — text | rect | pdf | djvu | map
  exact:
    type: string
  prefix:
    type: string
  suffix:
    type: string
  page:
    type: integer
  x:
    type: number
  y:
    type: number
  w:
    type: number                     # rect/pdf/djvu width — OR the map's west edge
  h:
    type: number
  n:
    type: number                     # map north edge
  s:
    type: number                     # map south edge
  e:
    type: number                     # map east edge
  image:
    type: binary
    format: image/png
    description: A PNG crop of the region (image-like fragments only); a sidecar blob by pointer
  created:
    type: string
