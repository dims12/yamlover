# FLATTENING (docs/language/flattening): depth moves into the key. Each row below is a
# COMMAND that paves its path - a segment ensures its node exists, the value lands at the
# end - and every segment after the first wears the yamlover/key/flat concrete, so the
# authored fold survives the round-trip byte for byte. The model is IDENTICAL to the
# nested spelling; nested stays the normalized (costless) form.

# Rows with a shared head pave into the SAME node - human1 is one mapping. A trailing `-`
# segment APPENDS a keyless element; switching to nested keying under the `-:` gives the
# new element its content, at the columns the nested spelling would have. (A comment or a
# blank line BETWEEN the rows of one group would break its fold - the documented fallback
# to nested form - so the group stays contiguous.)
human1: name: Alice
human1: age: 30
human1: pets: -:
      name: Whiskers
      kind: cat
human1: pets: -:
      name: Rex
      kind: dog

# a row of scalars is a repetition of trailing `-:` rows
scores: -: 7
scores: -: 9

# a flat path may land a reference - the pull is EXCLUSIVE: nothing else on the node
human2: name: Bob
human2: friend: *: human1
