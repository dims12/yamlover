# FLATTENING (docs/language/flattening): depth moves into the key. Each `flattenN:` block
# below is authored as FLAT ROWS - path-paving commands: a segment ensures its node exists,
# the value lands at the path's end, and every segment after the first wears the
# yamlover/key/flat concrete, so the authored fold survives the round-trip byte for byte.
# The `unflattenN:` twin spells the SAME model in the normalized nested form - parse both
# and the graphs are identical.

# rows with a shared head pave into the SAME node - human1 is one mapping. (A comment or a
# blank line BETWEEN the rows of one flat group would break its fold - the documented
# fallback to nested form - so each group stays contiguous.)
flatten1:
  human1: name: Alice
  human1: age: 30
unflatten1:
  human1:
    name: Alice
    age: 30

# a trailing `-` segment APPENDS a keyless element; switching to nested keying under the
# `-:` gives the new element its content, ONE indent step under the row - a flat key
# indents exactly like a normal key, whatever the path's depth
flatten2:
  human1: pets: -:
    name: Whiskers
    kind: cat
  human1: pets: -:
    name: Rex
    kind: dog
unflatten2:
  human1:
    pets:
      - name: Whiskers
        kind: cat
      - name: Rex
        kind: dog

# a row of scalars is a repetition of trailing `-:` rows
flatten3:
  scores: -: 7
  scores: -: 9
unflatten3:
  scores:
    - 7
    - 9

# a flat path may land a reference - the pull is EXCLUSIVE: nothing else on the node
flatten4:
  human1: name: Alice
  human2: friend: *human1
unflatten4:
  human1:
    name: Alice
  human2:
    friend: *human1

# flat rows and normal nesting COMPOSE, each keeping its own law: a normal key counts its
# indentation step by step, a flat row adds ONE step for its continuation - wherever either
# starts. Here a flat append sits inside a nested block, normal keys nest inside its
# element, and a normal sibling resumes after the continuation dedents
flatten5:
  company:
    staff: -:
      name: Carol
      contacts:
        email: c@e.org
    founded: 2001
unflatten5:
  company:
    staff:
      - name: Carol
        contacts:
          email: c@e.org
    founded: 2001

# normal keys inside a flat row's continuation nest by their own indentation
flatten6:
  a: b: c:
    normal:
      deep: 1
    other: 2
unflatten6:
  a:
    b:
      c:
        normal:
          deep: 1
        other: 2

# a flat row inside a flat row's continuation - each row adds its own single step
flatten7:
  a: b:
    inner: x: y: 9
unflatten7:
  a:
    b:
      inner:
        x:
          y: 9
