# examples/.yo/meta.yo — per-example descriptions (presentation metadata, docs/meta).
# Ported from the retired root schema.yaml, re-keyed to the current corpus; the prose
# counterpart lives in README.md. Types/formats are inferred — only descriptions here.
members:
  01-tour.json:
    description: strict JSON — the austere base of the lattice; no sharing
  02-tour.json5:
    description: JSON5 — comments, unquoted keys, trailing commas; a shared node is still a copy
  03-tour.json5p:
    description: json5p — JSON5 plus pointers — `*` deref, `~` back-edges, `&` anchors, scopes
  05-tour.yaml:
    description: plain YAML — native `&`/`*` anchor sharing, its ceiling
  06-tour.yo:
    description: yamlover — YAML plus the full pointer layer (`*`, `~`, `&`, bare-integer positions, links)
  07-omni.yo:
    description: the unified node (omni), tagless — a multi-line block-scalar self-value plus positional and keyed fields at once
  50-dir:
    description: an object as one file per child (name/age/isAdmin) — a plain directory, no overlay; the files are the data
  51-dir-yo:
    description: a directory whose `body.yo` overlay holds the whole object instance
  52-dir-index-yo:
    description: the object in an in-place `index.yo` — the overlay as a plain file inside the directory, instead of under `.yo/`
  54-dir-as-scalar:
    description: a directory that IS a scalar — its in-place `index.yo` holds just `30` (the scalar twin of 52)
  55-meta:
    description: the meta showcase — identical `.yaml` twins mounted as a parsed subtree vs one string (`format: text/x-yaml`), four bytes decoded to an integer (`binary/int32/le`), a png as binary
  56-array-of-files:
    description: a sequence whose elements live in files — the body pointer-array orders the members it names; an unreferenced file stays a keyed-only member
  58-genealogy-dag:
    description: the canonical DAG — containment is the paternal line, `*` the maternal cross-edge, `~` the reverses
  59-all-formats-object:
    description: a catalogue of every renderable (type, format) the viewer supports
  60-simple-chapter.yo:
    description: the minimal chapter — a single `!!<…>`-tagged file, the title as the root's self-value, subchapters titled/untitled/title-only, plus tagged bullet and numbered lists
  61-table.yo:
    description: a chapter with a `$defs:table` — flow and compact block rows, header widths, merged cells, a tagged nested table, an untagged chapter cell
  65-all-formats-chunks:
    description: a directory chapter interleaving textual chunks with `*`-pointer binary chunks
  66-pet-keeper-handbook:
    description: a recursive chapter tree where each chapter (dogs/cats/fish/puppies) is its own directory
  67-pdf-tags:
    description: real papers organized by a tag taxonomy — `*`-pointer membership authored both ways
  68-math-chapter:
    description: a chapter mixing marklower prose with standalone LaTeX chunks
  69-marklower-links.yo:
    description: nested chapters demonstrating `/`, `//` and external marklower links
  70-office-docs:
    description: office documents typed by extension (docx/xls/xlsx/rtf)
  71-kml-map:
    description: KML/KMZ maps drawn over an OpenStreetMap overlay
  72-images:
    description: photographs typed by extension (JPG/HEIC), shown in the pan/zoom image viewer
  73-dev-board:
    description: an agile board — a directory of `$defs:task` cards grouped into workflow lanes; drag-to-retag
